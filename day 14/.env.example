# Ключ DeepSeek — нужен для генерации и security review через шлюз.
DEEPSEEK_API_KEY=sk-xxxx
# Модель (по умолчанию deepseek-v4-flash)
# DEEPSEEK_MODEL=deepseek-v4-flash
# Порт встроенного LLM Gateway (по умолчанию 8014 = 8000 + номер дня)
# PORT=8014
# Rate limit шлюза, запросов/мин с одного IP (по умолчанию 30 — луп ходит залпами)
# RATE_LIMIT_PER_MIN=30
# Максимум итераций лупа на задачу (по умолчанию 3)
# MAX_ITERATIONS=3
