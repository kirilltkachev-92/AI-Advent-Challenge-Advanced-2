# Ключ DeepSeek — все этапы конвейера и монолитный вариант
DEEPSEEK_API_KEY=sk-xxxx
# Модель каждого этапа конфигурируется отдельно (по умолчанию deepseek-v4-flash)
# STAGE1_MODEL=deepseek-v4-flash
# STAGE2_MODEL=deepseek-v4-flash
# STAGE3_MODEL=deepseek-v4-flash
# MONO_MODEL=deepseek-v4-flash
# Модели микс-прогона `./run.sh mixed` (по умолчанию pro → flash → flash)
# MIXED_STAGE1_MODEL=deepseek-v4-pro
# MIXED_STAGE2_MODEL=deepseek-v4-flash
# MIXED_STAGE3_MODEL=deepseek-v4-flash
