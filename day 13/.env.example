# Ключ DeepSeek — нужен для проксирования запросов в LLM (block/mask работают и без него).
DEEPSEEK_API_KEY=sk-xxxx
# Модель (по умолчанию deepseek-v4-flash)
# DEEPSEEK_MODEL=deepseek-v4-flash
# Порт шлюза (по умолчанию 8013 = 8000 + номер дня)
# PORT=8013
# Rate limit: запросов к /v1/chat с одного IP за минуту (по умолчанию 10)
# RATE_LIMIT_PER_MIN=10
# Цены за 1M токенов, USD — приблизительные, для cost-tracking'а
# PRICE_INPUT_PER_1M=0.28
# PRICE_OUTPUT_PER_1M=0.42
