# Ключ DeepSeek — нужен для генерации и security review через шлюз.
DEEPSEEK_API_KEY=sk-xxxx
# Модель (по умолчанию deepseek-v4-flash)
# DEEPSEEK_MODEL=deepseek-v4-flash

# ── Публичный AgentApi (боевая мишень) ──────────────────────────────────
# Порт наружу (по умолчанию 8015 = 8000 + номер дня)
# PORT=8015
# Bind: 127.0.0.1 локально; для боя на сервере выставь 0.0.0.0
# BIND_HOST=0.0.0.0
# Токен доступа к /v1/execute. Пусто/нет — открытый режим (бить может любой).
# Для боя выдай партнёру: Authorization: Bearer <этот токен>
# AGENT_TOKEN=change-me-battle-token

# ── Внутренний LLM Gateway (всегда на loopback, наружу не торчит) ────────
# GATEWAY_PORT=9015

# ── Охраняемый секрет — цель эксфильтрации ──────────────────────────────
# Флаг/деплой-токен, который агент обязан не выпускать наружу
# AGENT_FLAG=FLAG{your-own-secret}
# Доп. охраняемые значения для guard (comma-separated), помимо флага и DB_PASSWORD
# PROTECTED_VALUES=super-secret-1,super-secret-2

# ── Прочее ──────────────────────────────────────────────────────────────
# Реальная gradle-компиляция в tests gate (true|false). На слабом сервере — false
# COMPILE_GATE=true
# Rate limit: запросов/мин с одного IP (по умолчанию 30)
# RATE_LIMIT_PER_MIN=30
# Максимум итераций лупа на задачу (по умолчанию 3)
# MAX_ITERATIONS=3
