# Ключ DeepSeek нужен только командам, которые реально гоняют агента: run | one.
# Команды catalog и sanitize — детерминированные офлайн-эшелоны, работают без ключа и без сети.
DEEPSEEK_API_KEY=sk-xxxx
# Модель агента, одна и та же во всех трёх режимах обороны (по умолчанию deepseek-v4-flash)
# AGENT_MODEL=deepseek-v4-flash
