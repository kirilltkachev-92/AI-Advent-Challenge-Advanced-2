# Ключ DeepSeek — только для LLM-fallback (уровень 2); micro-model работает без сети
DEEPSEEK_API_KEY=sk-xxxx
# Модель fallback (по умолчанию deepseek-v4-flash)
# FALLBACK_MODEL=deepseek-v4-flash
# Порог уверенности micro-model: ниже — уходим в fallback (по умолчанию 0.20)
# CONFIDENCE_THRESHOLD=0.20
