# Ключ DeepSeek нужен только командам, которые реально атакуют модель: run | one.
# Команды catalog и guard — детерминированные эшелоны, работают офлайн без ключа.
DEEPSEEK_API_KEY=sk-xxxx
# Модель-жертва, одна и та же для обоих режимов обороны (по умолчанию deepseek-v4-flash)
# ATTACK_MODEL=deepseek-v4-flash
# Порог блокировки на входе: сумма весов правил ≥ порога → запрос не доходит до LLM (по умолчанию 2.0)
# INPUT_BLOCK_THRESHOLD=2.0
